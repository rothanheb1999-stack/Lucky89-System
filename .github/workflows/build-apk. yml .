name: Build Android APK
on:
  workflow_dispatch:
  push:
    branches: [main, master]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Prepare web and icon folders
        run: |
          mkdir -p www assets
          [ -f index.html ] && cp index.html www/index.html
          [ -f manifest.webmanifest ] && cp manifest.webmanifest www/manifest.webmanifest
          [ -f icon.png ] && cp icon.png assets/icon.png
          [ -f assets/icon.png ] && cp assets/icon.png assets/icon-only.png && cp assets/icon.png assets/icon-foreground.png
          ls -R www assets
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: 17 }
      - run: npm install
      - run: npx cap add android
      - run: npx -y @capacitor/assets@3 generate --android --iconBackgroundColor '#080e22' --iconBackgroundColorDark '#080e22' || true
      - run: npx cap sync android
      - run: cd android && chmod +x gradlew && ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: Lucky89-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
